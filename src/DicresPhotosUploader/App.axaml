<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DicresPhotosUploader.UI.Controls"
             x:Class="DicresPhotosUploader.App"
             Name="DPU"
             RequestedThemeVariant="Default">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About DPU" Click="AppAbout_OnClick" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Color palette (light) -->
          <Color x:Key="ColorPrimary">#5B6EF5</Color>
          <Color x:Key="ColorPrimaryDark">#4756D6</Color>
          <Color x:Key="ColorPrimaryLight">#E8EBFE</Color>
          <Color x:Key="ColorSecondary">#14B8A6</Color>
          <Color x:Key="ColorSecondaryDark">#0F9488</Color>
          <Color x:Key="ColorSecondaryLight">#DCFAF6</Color>
          <Color x:Key="ColorBackground">#F3F5FB</Color>
          <Color x:Key="ColorSurface">#FFFFFF</Color>
          <Color x:Key="ColorBorder">#E2E5F1</Color>
          <Color x:Key="ColorTextPrimary">#1E2233</Color>
          <Color x:Key="ColorTextSecondary">#6B7280</Color>
          <Color x:Key="ColorSuccess">#22C55E</Color>
          <Color x:Key="ColorWarning">#F59E0B</Color>
          <Color x:Key="ColorDanger">#EF4444</Color>

          <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
          <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
          <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource ColorPrimaryLight}" />
          <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ColorSecondary}" />
          <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource ColorSecondaryDark}" />
          <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource ColorSecondaryLight}" />
          <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
          <SolidColorBrush x:Key="BorderColorBrush" Color="{StaticResource ColorBorder}" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
          <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
          <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
          <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <!-- Color palette (dark) -->
          <Color x:Key="ColorPrimary">#7C8CF7</Color>
          <Color x:Key="ColorPrimaryDark">#5B6EF5</Color>
          <Color x:Key="ColorPrimaryLight">#2E3358</Color>
          <Color x:Key="ColorSecondary">#2DD4BF</Color>
          <Color x:Key="ColorSecondaryDark">#14B8A6</Color>
          <Color x:Key="ColorSecondaryLight">#113B38</Color>
          <Color x:Key="ColorBackground">#14161F</Color>
          <Color x:Key="ColorSurface">#1E2130</Color>
          <Color x:Key="ColorBorder">#30354A</Color>
          <Color x:Key="ColorTextPrimary">#F1F2F8</Color>
          <Color x:Key="ColorTextSecondary">#9CA3B8</Color>
          <Color x:Key="ColorSuccess">#4ADE80</Color>
          <Color x:Key="ColorWarning">#FBBF24</Color>
          <Color x:Key="ColorDanger">#F87171</Color>

          <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
          <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}" />
          <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource ColorPrimaryLight}" />
          <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ColorSecondary}" />
          <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource ColorSecondaryDark}" />
          <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource ColorSecondaryLight}" />
          <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
          <SolidColorBrush x:Key="BorderColorBrush" Color="{StaticResource ColorBorder}" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
          <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
          <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
          <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Re-tint the Fluent accent so built-in controls (CheckBox, ToggleSwitch...) match the palette in both themes -->
      <Color x:Key="SystemAccentColor">#5B6EF5</Color>
      <Color x:Key="SystemAccentColorDark1">#4756D6</Color>
      <Color x:Key="SystemAccentColorDark2">#3A46B0</Color>
      <Color x:Key="SystemAccentColorDark3">#2D3689</Color>
      <Color x:Key="SystemAccentColorLight1">#7C8CF7</Color>
      <Color x:Key="SystemAccentColorLight2">#9EA9F9</Color>
      <Color x:Key="SystemAccentColorLight3">#C0C8FC</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Panels / cards -->
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 1 8 0 #14000000" />
    </Style>

    <!-- Tabs styled as rounded pills -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
    </Style>
    <Style Selector="TabItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector=":is(Button)">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector=":is(Button):pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
    </Style>
    <Style Selector=":is(Button).Primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(Button).Primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
    </Style>
    <Style Selector=":is(Button).Secondary">
      <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(Button).Secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource SecondaryDarkBrush}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="CheckBox /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Button with an embedded activity indicator, shown while its action is running -->
    <Style Selector="controls|LoadingButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Panel>
              <!-- Kept in the tree while busy (only transparent) so the button keeps its size -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border x:Name="PART_Spinner"
                      Width="16" Height="16"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding IsSpinnerVisible, RelativeSource={RelativeSource TemplatedParent}}"
                      BorderThickness="2"
                      BorderBrush="{TemplateBinding Foreground}"
                      CornerRadius="8"
                      Opacity="0.35" />
              <Arc x:Name="PART_SpinnerArc"
                   Width="16" Height="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsSpinnerVisible, RelativeSource={RelativeSource TemplatedParent}}"
                   Stroke="{TemplateBinding Foreground}"
                   StrokeThickness="2"
                   StrokeLineCap="Round"
                   StartAngle="0" SweepAngle="110"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="rotate(0deg)" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|LoadingButton:busy /template/ Arc#PART_SpinnerArc">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Busy keeps full opacity so the spinner stays readable, unlike a plain disabled button -->
    <Style Selector="controls|LoadingButton:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="controls|LoadingButton:busy">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="controls|LoadingButton:busy /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="TimePicker">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <!-- Lists -->
    <Style Selector="ListBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Progress bars -->
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ProgressBar.Danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="ProgressBar.Success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- DataGrid -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColorBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Application.Styles>
</Application>
