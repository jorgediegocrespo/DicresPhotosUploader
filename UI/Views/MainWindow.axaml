<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DicresPhotosUploader.UI.ViewModels"
        xmlns:views="using:DicresPhotosUploader.UI.Views"
        xmlns:loc="using:DicresPhotosUploader.Localization"
        x:Class="DicresPhotosUploader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dicres Photos Uploader"
        Icon="avares://DicresPhotosUploader/assets/app.ico"
        Background="{DynamicResource BackgroundBrush}"
        Width="960" Height="720">
  <TabControl Margin="16" SelectedIndex="{Binding SelectedTabIndex}">
    <TabItem Header="{loc:Tr Tab_Dashboard}" IsEnabled="{Binding Config.IsConfigurationComplete}">
      <views:DashboardView DataContext="{Binding Dashboard}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_Configuration}">
      <views:ConfigView DataContext="{Binding Config}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_Schedule}" IsEnabled="{Binding Config.IsConfigurationComplete}">
      <views:ScheduleView DataContext="{Binding Schedule}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_History}" IsEnabled="{Binding Config.IsConfigurationComplete}">
      <views:HistoryView DataContext="{Binding History}" />
    </TabItem>
  </TabControl>
</Window>
