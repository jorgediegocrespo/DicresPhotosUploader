<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GooglePhotosUploader.UI.ViewModels"
        xmlns:views="using:GooglePhotosUploader.UI.Views"
        xmlns:loc="using:GooglePhotosUploader.Localization"
        x:Class="GooglePhotosUploader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Google Photos Uploader"
        Icon="avares://GooglePhotosUploader/assets/app.ico"
        Background="{DynamicResource BackgroundBrush}"
        Width="960" Height="680">
  <TabControl Margin="16">
    <TabItem Header="{loc:Tr Tab_Dashboard}">
      <views:DashboardView DataContext="{Binding Dashboard}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_Configuration}">
      <views:ConfigView DataContext="{Binding Config}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_Schedule}">
      <views:ScheduleView DataContext="{Binding Schedule}" />
    </TabItem>
    <TabItem Header="{loc:Tr Tab_History}">
      <views:HistoryView DataContext="{Binding History}" />
    </TabItem>
  </TabControl>
</Window>
