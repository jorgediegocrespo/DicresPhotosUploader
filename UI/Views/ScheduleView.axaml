<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GooglePhotosUploader.UI.ViewModels"
             x:Class="GooglePhotosUploader.UI.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel">
  <ScrollViewer Margin="16">
    <Border Classes="Card" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <TextBlock Text="Run days" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DayOption">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Time" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TimePicker SelectedTime="{Binding ScheduledTime}" HorizontalAlignment="Left" />

        <CheckBox Content="Enable background execution" IsChecked="{Binding BackgroundScheduleEnabled}" />

        <Button Content="Save schedule" Classes="Primary" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

        <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="12,10">
          <TextBlock Text="You must sign in with Google (Configuration tab) before enabling the schedule. The app must be installed in its final location before saving the schedule."
                     TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
