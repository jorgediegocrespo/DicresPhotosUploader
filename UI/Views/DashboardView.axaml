<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GooglePhotosUploader.UI.ViewModels"
             x:Class="GooglePhotosUploader.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <Grid Margin="16" ColumnDefinitions="2*,3*" RowDefinitions="Auto,*">
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="Card" Margin="0,0,0,16">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding LastRunSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding UploadedFilesTotal, StringFormat='Historical total uploaded: {0}'}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
          <Button Content="Run now" Classes="Primary" Command="{Binding RunNowCommand}" IsEnabled="{Binding !IsRunning}" />
          <Button Content="Reprocess errors" Classes="Secondary" Command="{Binding ReprocessErrorsCommand}" IsEnabled="{Binding !IsRunning}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="Card" Margin="0,0,16,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Progress by album" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Albums}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumProgress">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding UploadedCount}" Height="8" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} / {1} uploaded">
                          <Binding Path="UploadedCount" />
                          <Binding Path="TotalCount" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Classes="Card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Run log" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
        <ListBox ItemsSource="{Binding LogLines}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
